{
  "name": "ipcrawl-open",
  "private": true,
  "type": "module",
  "description": "A multi-source catalog and live-preview surface for publicly documented open cameras.",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:ingest": "node scripts/test-ingest.mjs",
    "verify": "npm run typecheck && npm run test:unit && npm run test:ingest && npm run build",
    "generate:geo": "node scripts/generate-geo.mjs",
    "generate:brand": "node scripts/generate-brand-assets.mjs",
    "render:frame": "node scripts/render-frame.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "sensor": "node scripts/sensor.mjs"
  },
  "dependencies": {
