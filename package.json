    "@lucide/vue": "^1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "nuxt": "^4.6.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.0.0",
    "@types/topojson-client": "^3.1.5",
    "topojson-client": "^3.1.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
