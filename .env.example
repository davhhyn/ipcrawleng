# ── IPCrawl Open ────────────────────────────────────────────────────────────
# Every source below is FREE and keyless except Windy, which is optional.
# The catalogue works out of the box with the bundled dataset even offline.

# Directory for the SQLite index, thumbnail cache and SWR cache.
# Baked into the build, so set it before `npm run build` if you mount a volume.
# NUXT_DATA_DIR=./.data

# Where the SQLite index lives (defaults to $NUXT_DATA_DIR/ipcrawl.sqlite)
# NUXT_DB_PATH=/srv/ipcrawl/data/ipcrawl.sqlite

# Comma-separated provider allow-list. Available:
#   curated, osm, tfl, digitraffic, windy, internetdb
# Default: curated,osm,tfl,digitraffic,internetdb
# NUXT_SYNC_SOURCES=curated,osm,tfl,digitraffic

# Seed the bundled demo catalogue on first boot (default: true)
# NUXT_SEED_DEMO=true

# Allow the "Sync now" button / POST /api/sources/sync.
# Leave empty in production and trigger the daily Nitro task instead.
# NUXT_SYNC_TOKEN=

# Probe upstream feeds for liveness during syncs and on-demand (default: true)
# NUXT_ENABLE_LIVE_PROBE=true
# NUXT_LIVE_PROBE_TIMEOUT_MS=4000
# NUXT_LIVE_PROBE_BUDGET_MS=45000

# Optional: Windy Webcams API key (free tier at https://api.windy.com/keys)
# NUXT_WINDY_API_KEY=

# Optional: Shodan API (paid plan). Needs BOTH this key and `shodan` in
# NUXT_SYNC_SOURCES — the keyless defaults never touch Shodan.
# NUXT_SHODAN_API_KEY=
# Any Shodan search filter: https://www.shodan.io/search/filters
# NUXT_SHODAN_QUERY=has_screenshot:true port:80,443,8080,8000,8081,8443,8888
# Pages per run (100 matches each, max 5) and the gap between requests (Shodan allows ~1/s)
# NUXT_SHODAN_PAGES=1
# NUXT_SHODAN_MIN_INTERVAL_MS=1100

# Overpass mirror used by the OpenStreetMap provider
# NUXT_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Per-source ingestion cap (default: 600)
# NUXT_MAX_INGEST_PER_SOURCE=600

# Comma-separated host suffixes or camera ids that must never be published.
# NUXT_BLOCKED_HOSTS=

# Test-only: allow loopback/private fixtures to be ingested. NEVER in prod.
# NUXT_ALLOW_PRIVATE_HOSTS=false

# ── Local sensor (see docs/LOCAL-SENSOR.md) ────────────────────────────────
# The CLI needs NUXT_SYNC_TOKEN (above) to store results; without it, use --no-write.
# Disable the ingest endpoint entirely (default: true)
# NUXT_SENSOR_INGEST=true
# Let the frame proxy thumbnail sensor rows on private IPs (default: true)
# NUXT_SENSOR_FETCH_LOCAL=true
# Allow non-loopback ingest. Leave false: scanning stays on the operator's machine.
# NUXT_SENSOR_ALLOW_REMOTE_INGEST=false
# Where `npm run sensor` sends results (default: http://localhost:3000)
# NUXT_SENSOR_URL=http://localhost:3000

# Salt used to hash favorite voters (set a long random value in production)
# NUXT_VOTER_PEPPER=

# Optional featured camera id pinned to the top of the catalogue
# NUXT_PUBLIC_FEATURED_CAM_ID=

# Canonical site URL, used for metadata
# NUXT_PUBLIC_SITE_URL=https://example.com
